SECRET_KEY=luanvan_ocr_secret_key_2026_CHANGE_IN_PROD

# SQL Server (container kết nối vào SQL Server 2022 trên máy host)
# Nếu instance của bạn chưa ghim port, hãy đặt TCP port cố định trong SQL Server Configuration Manager.
DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+17+for+SQL+Server%7D%3BSERVER%3Dhost.docker.internal%2C1500%3BDATABASE%3Docr_vanban%3BUID%3Dappuser%3BPWD%3DStrongP%40ssw0rd%21%3BEncrypt%3Dno%3BTrustServerCertificate%3Dyes%3B
# Redis (dùng tên service trong Docker Compose)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# VnCoreNLP (bật khi đã cài JAR + models)
USE_VNCORENLP=false
VNCORENLP_JAR=/app/vncorenlp/VnCoreNLP-1.2.jar
VNCORENLP_MODELS=/app/vncorenlp/models
